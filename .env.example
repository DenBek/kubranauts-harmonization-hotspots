# Copy to .env and fill in. Never commit .env (it is gitignored).
# In Codespaces these come from repo secrets; .env is only for local use.

# Cloudflare R2 (bucket: firms-data), S3-style credentials
R2_KEY_ID=
R2_SECRET=
# Account ID = hex prefix of https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com
CF_ACCOUNT_ID=

# NASA FIRMS API map key (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# Optional
# CF_API_TOKEN=
# R2_ENDPOINT=https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com

# Gemini (chat assistant). Local dev reads this; on Cloudflare set it as a Pages secret.
GEMINI_API_KEY=
